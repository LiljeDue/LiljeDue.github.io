// Wyllie's list ranking, round 1. Each node shows its rank and, below, its index.
// Grey nodes have succ = -1, so their rank is final.
digraph {
  rankdir=LR; ranksep=0.3;
  node [shape=circle, width=0.55, fixedsize=true, fontname="Helvetica"];
  edge [arrowsize=0.6];

  label [shape=plaintext, width=0.9, label="Round 1"];
  n0 [label=<2<BR/><FONT POINT-SIZE="8">[0]</FONT>>];
  n1 [label=<2<BR/><FONT POINT-SIZE="8">[1]</FONT>>];
  n2 [label=<2<BR/><FONT POINT-SIZE="8">[2]</FONT>>];
  n3 [label=<2<BR/><FONT POINT-SIZE="8">[3]</FONT>>];
  n4 [label=<2<BR/><FONT POINT-SIZE="8">[4]</FONT>>];
  n5 [label=<2<BR/><FONT POINT-SIZE="8">[5]</FONT>>];
  n6 [label=<1<BR/><FONT POINT-SIZE="8">[6]</FONT>>, style=filled, fillcolor="#dddddd"];
  n7 [label=<0<BR/><FONT POINT-SIZE="8">[7]</FONT>>, style=filled, fillcolor="#dddddd"];

  // Keeps the nodes in a row, in index order.
  label -> n0 -> n1 -> n2 -> n3 -> n4 -> n5 -> n6 -> n7 [style=invis, weight=100];

  // succ pointers
  n0 -> n2 [constraint=false];
  n1 -> n3 [constraint=false];
  n2 -> n4 [constraint=false];
  n3 -> n5 [constraint=false];
  n4 -> n6 [constraint=false];
  n5 -> n7 [constraint=false];
}
